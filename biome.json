{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!fonts",
      "!node_modules",
      "!**/*.svg",
      "!evals/results",
      "!tests/.tmp",
      "!examples/**/output",
      "!branding/**/*.html",
      "!branding/**/exports",
      "!**/*.png"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off"
      },
      "complexity": {
        "noForEach": "off"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off"
      }
    }
  }
}
